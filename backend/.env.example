# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas URI — include credentials in the URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=smart_attendance

# ── Frontend URL (used inside email links) ────────────────────────────────────
# Local development:
#   FRONTEND_BASE_URL=http://localhost:8000/static
# Production on Render:
#   FRONTEND_BASE_URL=https://your-app-name.onrender.com/static
FRONTEND_BASE_URL=http://localhost:8000/static

# ── Email (Gmail App Password) ────────────────────────────────────────────────
# Create an App Password at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password-16chars
MAIL_FROM=your-gmail@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
MAIL_ENABLED=true

# ── Campus / Geofencing ───────────────────────────────────────────────────────
CAMPUS_LAT=12.846910
CAMPUS_LON=77.680528
MAX_DISTANCE_KM=3.0

# ── Attendance Timing ─────────────────────────────────────────────────────────
LATE_HOUR=10
LATE_MINUTE=30
ABSENT_NOTICE_HOUR=17
ABSENT_NOTICE_MINUTE=0

# ── Feature Flags ─────────────────────────────────────────────────────────────
FACE_TOLERANCE=0.5
FACE_RECOGNITION_ENABLED=true
MFA_ENABLED=false
GEOFENCING_ENABLED=false
LOCKOUT_ENABLED=false
ABSENT_NOTIFICATIONS_ENABLED=true

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Leave blank → defaults to wildcard "*" (appropriate when API + frontend are
# served from the same Render URL). Set to your actual domain if the frontend
# is on a separate origin:
#   ALLOWED_ORIGINS=https://my-frontend.onrender.com
ALLOWED_ORIGINS=
